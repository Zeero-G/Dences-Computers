  "narrative": {
    "northStar": "Dences monochrome electronics storefront",
    "overview": "The user-supplied angular white-on-black Dences logo anchors the approved monochrome ecommerce kit's adaptation to electronics. White pages, black actions, quiet grey image wells and contained product photography give devices and prices the strongest visual presence. Desktop layouts extend the mobile kit into a spacious customer storefront.\n\nThe implemented system uses handcrafted CSS, local General Sans fonts, Lucide line icons and restrained Motion interactions. Shared customer components belong to this identity; the later protected ERP has no implemented visual system yet. This record describes the shipped frontend, without adding a new visual direction.",
    "keyCharacteristics": [
      "Monochrome surfaces and high-contrast primary actions.",
      "Contained device imagery and compact product information.",
      "Gently rounded controls, flat surfaces and fine dividers.",
      "Responsive shopping layouts with restrained, reduced-motion-aware interactions."
    ],
    "rules": [
      {
        "name": "The Monochrome Action Rule",
        "body": "Use ink and paper for primary actions and selection; reserve semantic colors for their implemented meanings.",
        "section": "colors"
      },
      {
        "name": "The Readable Metadata Rule",
        "body": "Preserve the final stylesheet's legibility overrides: product metadata uses (11px) desktop, (10px) mobile and (9px) on the narrowest screens; product summaries use (12px) desktop and (11px) mobile. Earlier declarations are superseded.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal separation and dividers for resting product cards and panels; retain shadows for implemented floating feedback and menus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the supplied Dences logo and the approved monochrome kit adaptation.",
      "**Do** reuse the existing CSS tokens and shared customer components before introducing variants.",
      "**Do** retain keyboard focus, accessible icon labels, state semantics and reduced-motion support.",
      "**Do** label sample products and prices and keep local-preview notices beside relevant actions.",
      "**Do** use contained product imagery and test text at both catalogue densities."
    ],
    "donts": [
      "**Don't** introduce a new accent palette, display font or decorative shadow language without an approved identity change.",
      "**Don't** replace actual code values with framework defaults or an aspirational component-library stack.",
      "**Don't** imply live stock, a sent request, an uploaded receipt, verified payment or a payment gateway in the preview.",
      "**Don't** extend customer storefront rules into an invented ERP interface."
    ]
  }
